{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "serveros/federation-object.v1",
  "type": "object",
  "required": ["domain", "object_id", "kind", "locator", "observed_at"],
  "properties": {
    "domain": {"enum": ["feishu", "github", "local"]},
    "object_id": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "minLength": 1},
    "locator": {"type": "string", "minLength": 1},
    "owner": {"type": "string"},
    "parent": {"type": ["string", "null"]},
    "classification": {"type": "string"},
    "revision": {"type": ["string", "null"]},
    "visibility": {"type": "string"},
    "content_policy": {"enum": ["locator-only", "im-only-context"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "last_verified_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": false
}
