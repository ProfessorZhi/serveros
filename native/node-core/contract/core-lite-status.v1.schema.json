{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "serveros/core-lite-status.v1",
  "title": "Core-Lite status — one read-only document, three machines",
  "description": "The machine-checkable form of contract/core-lite-status.v1.md. It exists because a consumer had to GUESS the value shapes before it did, and three of those guesses disagreed with what this producer emits. Every object is additionalProperties:false, so a reader can tell from this file alone which keys may appear.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "node",
    "principal",
    "platform",
    "generation",
    "mode",
    "freshness",
    "live",
    "principal_identity",
    "device_identity",
    "observations"
  ],
  "properties": {
    "schema": {
      "const": "serveros/core-lite-status.v1"
    },
    "node": {
      "type": "string",
      "description": "A CLAIM. Nothing in V1 can attest a device reference; a consumer must compare it against the route it already holds."
    },
    "principal": {
      "type": "string",
      "description": "A CLAIM until principal_identity says MATCHED, which only this process's own OS readback can establish."
    },
    "platform": {
      "type": "string"
    },
    "generation": {
      "type": "integer"
    },
    "mode": {
      "const": "observe-only"
    },
    "observed_at": {
      "type": "string",
      "description": "The SOURCE's own sample time, copied. Absent when the source stated none — which is not the same as now."
    },
    "freshness": {
      "const": "NOT_ASSERTED",
      "description": "This producer has no clock it trusts. Deciding a reading is stale belongs to a trusted Node or Fleet reader."
    },
    "principal_identity": {
      "$ref": "#/$defs/identity_verdict"
    },
    "device_identity": {
      "$ref": "#/$defs/identity_verdict"
    },
    "live": {
      "type": "boolean",
      "description": "True only when the principal MATCHED and the device MATCHED on an ATTESTED basis. False for every document this revision emits."
    },
    "observations": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "oneOf": [
          {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "state",
                  "reason"
                ],
                "properties": {
                  "name": {
                    "const": "cpu"
                  },
                  "state": {
                    "const": "UNAVAILABLE"
                  },
                  "reason": {
                    "$ref": "#/$defs/reason"
                  },
                  "source": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "state",
                  "value"
                ],
                "properties": {
                  "name": {
                    "const": "cpu"
                  },
                  "state": {
                    "const": "PRESENT"
                  },
                  "value": {
                    "$ref": "#/$defs/cpu_value"
                  },
                  "completeness": {
                    "enum": [
                      "COMPLETE",
                      "PARTIAL"
                    ]
                  },
                  "source": {
                    "type": "string"
                  },
                  "observed_at": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "state",
                  "reason"
                ],
                "properties": {
                  "name": {
                    "const": "memory"
                  },
                  "state": {
                    "const": "UNAVAILABLE"
                  },
                  "reason": {
                    "$ref": "#/$defs/reason"
                  },
                  "source": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "state",
                  "value"
                ],
                "properties": {
                  "name": {
                    "const": "memory"
                  },
                  "state": {
                    "const": "PRESENT"
                  },
                  "value": {
                    "$ref": "#/$defs/memory_value"
                  },
                  "completeness": {
                    "enum": [
                      "COMPLETE",
                      "PARTIAL"
                    ]
                  },
                  "source": {
                    "type": "string"
                  },
                  "observed_at": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "state",
                  "reason"
                ],
                "properties": {
                  "name": {
                    "const": "swap"
                  },
                  "state": {
                    "const": "UNAVAILABLE"
                  },
                  "reason": {
                    "$ref": "#/$defs/reason"
                  },
                  "source": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "state",
                  "value"
                ],
                "properties": {
                  "name": {
                    "const": "swap"
                  },
                  "state": {
                    "const": "PRESENT"
                  },
                  "value": {
                    "$ref": "#/$defs/swap_value"
                  },
                  "completeness": {
                    "enum": [
                      "COMPLETE",
                      "PARTIAL"
                    ]
                  },
                  "source": {
                    "type": "string"
                  },
                  "observed_at": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "state",
                  "reason"
                ],
                "properties": {
                  "name": {
                    "const": "psi.cpu"
                  },
                  "state": {
                    "const": "UNAVAILABLE"
                  },
                  "reason": {
                    "$ref": "#/$defs/reason"
                  },
                  "source": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "state",
                  "value"
                ],
                "properties": {
                  "name": {
                    "const": "psi.cpu"
                  },
                  "state": {
                    "const": "PRESENT"
                  },
                  "value": {
                    "$ref": "#/$defs/psi_value"
                  },
                  "completeness": {
                    "enum": [
                      "COMPLETE",
                      "PARTIAL"
                    ]
                  },
                  "source": {
                    "type": "string"
                  },
                  "observed_at": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "state",
                  "reason"
                ],
                "properties": {
                  "name": {
                    "const": "psi.memory"
                  },
                  "state": {
                    "const": "UNAVAILABLE"
                  },
                  "reason": {
                    "$ref": "#/$defs/reason"
                  },
                  "source": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "state",
                  "value"
                ],
                "properties": {
                  "name": {
                    "const": "psi.memory"
                  },
                  "state": {
                    "const": "PRESENT"
                  },
                  "value": {
                    "$ref": "#/$defs/psi_value"
                  },
                  "completeness": {
                    "enum": [
                      "COMPLETE",
                      "PARTIAL"
                    ]
                  },
                  "source": {
                    "type": "string"
                  },
                  "observed_at": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "state",
                  "reason"
                ],
                "properties": {
                  "name": {
                    "const": "psi.io"
                  },
                  "state": {
                    "const": "UNAVAILABLE"
                  },
                  "reason": {
                    "$ref": "#/$defs/reason"
                  },
                  "source": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "state",
                  "value"
                ],
                "properties": {
                  "name": {
                    "const": "psi.io"
                  },
                  "state": {
                    "const": "PRESENT"
                  },
                  "value": {
                    "$ref": "#/$defs/psi_value"
                  },
                  "completeness": {
                    "enum": [
                      "COMPLETE",
                      "PARTIAL"
                    ]
                  },
                  "source": {
                    "type": "string"
                  },
                  "observed_at": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "state",
                  "reason"
                ],
                "properties": {
                  "name": {
                    "const": "storage.readonly"
                  },
                  "state": {
                    "const": "UNAVAILABLE"
                  },
                  "reason": {
                    "$ref": "#/$defs/reason"
                  },
                  "source": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "state",
                  "value"
                ],
                "properties": {
                  "name": {
                    "const": "storage.readonly"
                  },
                  "state": {
                    "const": "PRESENT"
                  },
                  "value": {
                    "$ref": "#/$defs/storage_value"
                  },
                  "completeness": {
                    "enum": [
                      "COMPLETE",
                      "PARTIAL"
                    ]
                  },
                  "source": {
                    "type": "string"
                  },
                  "observed_at": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "state",
                  "reason"
                ],
                "properties": {
                  "name": {
                    "const": "services"
                  },
                  "state": {
                    "const": "UNAVAILABLE"
                  },
                  "reason": {
                    "$ref": "#/$defs/reason"
                  },
                  "source": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "state",
                  "value"
                ],
                "properties": {
                  "name": {
                    "const": "services"
                  },
                  "state": {
                    "const": "PRESENT"
                  },
                  "value": {
                    "$ref": "#/$defs/services_value"
                  },
                  "completeness": {
                    "enum": [
                      "COMPLETE",
                      "PARTIAL"
                    ]
                  },
                  "source": {
                    "type": "string"
                  },
                  "observed_at": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "state",
                  "reason"
                ],
                "properties": {
                  "name": {
                    "const": "gpu.readonly"
                  },
                  "state": {
                    "const": "UNAVAILABLE"
                  },
                  "reason": {
                    "$ref": "#/$defs/reason"
                  },
                  "source": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "state",
                  "value"
                ],
                "properties": {
                  "name": {
                    "const": "gpu.readonly"
                  },
                  "state": {
                    "const": "PRESENT"
                  },
                  "value": {
                    "$ref": "#/$defs/gpu_value"
                  },
                  "completeness": {
                    "enum": [
                      "COMPLETE",
                      "PARTIAL"
                    ]
                  },
                  "source": {
                    "type": "string"
                  },
