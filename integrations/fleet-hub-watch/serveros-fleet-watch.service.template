# TEMPLATE — SOURCE ONLY. THIS FILE IS NOT A UNIT.
#
# Rendering input for the hub watcher's user unit. Every @HUB_...@ is
# substituted by the renderer (distribution/device_kit.py) or by the operator;
# nothing here has a default. @HUB_NOTIFY@ in particular is required: it decides
# whether the watcher sends cards, writes them to a journal, or runs without a
# notifier at all, and that is an owner decision made at install time, not a
# fallback chosen here.

[Unit]
Description=ServerOS Fleet hub watcher (discovers runs, records outcomes once)
Documentation=@HUB_DOC_URL@
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
Environment=PYTHONPATH=@HUB_REPO@:@HUB_REPO@/integrations/fleet-next-agent-monitor:@HUB_REPO@/integrations/fleet-hub-watch
ExecStart=@HUB_PYTHON@ -m fleet_hub_watch --config @HUB_BINDING@ --interval 30 --notify @HUB_NOTIFY@@HUB_ALERTS@
Restart=on-failure
RestartSec=30
MemoryMax=256M
# The watcher shells out to `lark-cli`, whose Go runtime starts one OS
# thread per core plus its own spares: a ceiling that fits the Python
# process alone kills the CLI with `failed to create new OS thread
# (errno=11)` before it sends anything. Sized for the host it runs on
# (128 cores), not for what the watcher itself needs.
TasksMax=512
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
