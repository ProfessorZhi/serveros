#!/usr/bin/env python3
"""serveros-fleet-mcp — executable entry point for the off-host Fleet surface.

Kept as a short shim so that the module it runs stays importable and testable.
This is also the file a systemd unit or a symlink on PATH points at, so that
`serveros-fleet-mcp` is one program with one location rather than a re-export of
a package's internals — the same shape as `bin/serverosctl` and `mcp/bin/*`.

One difference from `mcp/bin/*`: this package sits at the repository root
rather than in a directory of its own, so the path inserted is the root and the
import is `fleet_mcp.runtime` rather than a top-level module beside it.
"""
import sys
from pathlib import Path

# The revision this shim points at is meant to be immutable: `release.py`
# records a tree hash for it and the node's identity IS that hash. Importing a
# module next to this file makes Python write `__pycache__` into the tree, so a
# single `--help` is enough to make a recorded hash unreachable. `bin/serverosctl`
# carries the same line for the same reason; set in code rather than in a unit's
# Environment= because this shim is also run from a shell, where no unit file
# applies.
sys.dont_write_bytecode = True

sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))

from fleet_mcp import runtime  # noqa: E402

if __name__ == "__main__":
    sys.exit(runtime.main())
