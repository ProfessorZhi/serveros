# ServerOS is documentation + component registry. No runtime state, maps,
# generated payloads, secrets or evidence may enter this repository.

# runtime state / generated artifacts
__pycache__/
*.pyc
*.pyo

# built plugin payload. The runtime artifact has exactly one home —
# $DATA_ROOT/runtime-assets/hwz-server-os — and must never be committed here,
# so that this repository stays the single plugin canonical source.
plugin/build/
.agents/
# The committed Codex distribution is a local marketplace and needs its .agents/.
!distribution/codex/.agents/
# The repository root is the Codex `serveros-fleet` marketplace: its one file
# (written by distribution/build.py) is committed, nothing else under .agents/.
!/.agents/
/.agents/*
!/.agents/plugins/
/.agents/plugins/*
!/.agents/plugins/marketplace.json

# secrets — never commit
.env
.env.*
*.pem
*.key
secrets/
.secrets/

# editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
