{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-packet.schema.json",
  "title": "research-packet.v1",
  "description": "ServerOS research-exchange request manifest. Structural and format contract only. It grants no sharing permission, performs no redaction and authorizes no execution. Data-policy labels are metadata, not authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "project_ref",
    "item_ref",
    "run_ref",
    "objective",
    "questions",
    "inputs",
    "requested_output",
    "limits",
    "data_policy",
    "handoff"
  ],
  "properties": {
    "schema": {"const": "research-packet.v1"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"},
    "project_ref": {"$ref": "#/$defs/ref"},
    "item_ref": {"$ref": "#/$defs/ref"},
    "run_ref": {"$ref": "#/$defs/ref"},
    "objective": {"type": "string", "minLength": 8},
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 4}
    },
    "non_goals": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "input_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/input"}
    },
    "source_refs": {"type": "array", "items": {"$ref": "#/$defs/source_ref"}},
    "known_facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "hypotheses": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "ruled_out": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "requested_output": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 3}
    },
    "limits": {"$ref": "#/$defs/limits"},
    "data_policy": {"$ref": "#/$defs/data_policy"},
    "handoff": {"$ref": "#/$defs/handoff"}
  },
  "$defs": {
    "ref": {"type": "string", "minLength": 3},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "purpose"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "purpose": {"type": "string", "minLength": 3}
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "coverage"],
      "properties": {
        "locator": {"type": "string", "minLength": 3},
        "kind": {"enum": ["repo", "web", "issue", "doc", "other"]},
        "revision": {"type": "string", "minLength": 1},
        "read_at": {"type": "string", "minLength": 10},
        "coverage": {"type": "string", "minLength": 3},
        "gaps": {"type": "string", "minLength": 1}
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "evidence"],
      "properties": {
        "statement": {"type": "string", "minLength": 4},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_seconds", "max_tool_calls", "max_cost_usd", "max_output_bytes"],
      "properties": {
        "wall_seconds": {"type": "number", "exclusiveMinimum": 0},
        "max_tool_calls": {"type": "integer", "minimum": 0},
        "max_cost_usd": {"type": "number", "minimum": 0},
        "max_output_bytes": {"type": "integer", "exclusiveMinimum": 0}
      }
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "permission_ref", "audience"],
      "properties": {
        "classification": {"enum": ["public", "internal", "confidential", "restricted"]},
        "permission_ref": {"type": "string", "minLength": 1},
        "audience": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "retention": {"type": "string", "minLength": 1},
        "expires_at": {"type": "string", "minLength": 10}
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_ref", "result_prefix"],
      "properties": {
        "parent_ref": {"type": "string", "minLength": 3},
        "result_prefix": {"type": "string", "pattern": "^results/([A-Za-z0-9._-]+/)?$"},
        "target_repo": {"type": "string", "minLength": 3},
        "review_surface": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
