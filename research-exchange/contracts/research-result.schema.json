{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-result.schema.json",
  "title": "research-result.v1",
  "description": "ServerOS research-exchange result manifest. Records what a researcher read and concluded. It carries no human approval, no Work transition and no budget expansion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "result_id",
    "input_revision",
    "status",
    "answers",
    "provider",
    "report_path"
  ],
  "properties": {
    "schema": {"const": "research-result.v1"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"},
    "result_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"},
    "input_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "status": {"enum": ["COMPLETE", "PARTIAL", "BLOCKED"]},
    "answers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/answer"}
    },
    "source_refs": {"type": "array", "items": {"$ref": "#/$defs/source_ref"}},
    "counterevidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "recommendations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "alternatives": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reproduction": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "uncovered": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "provider": {"type": "string", "minLength": 2},
    "provider_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "report_path": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "answer", "evidence"],
      "properties": {
        "question": {"type": "string", "minLength": 4},
        "answer": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "coverage"],
      "properties": {
        "locator": {"type": "string", "minLength": 3},
        "kind": {"enum": ["repo", "web", "issue", "doc", "other"]},
        "revision": {"type": "string", "minLength": 1},
        "read_at": {"type": "string", "minLength": 10},
        "coverage": {"type": "string", "minLength": 3},
        "gaps": {"type": "string", "minLength": 1}
      }
    }
  }
}
