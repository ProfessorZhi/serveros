[Unit]
Description=ServerOS key center: pull, decrypt this device's bundles, restart what reads them
After=network-online.target

[Service]
Type=oneshot
# A user unit's PATH has no ~/.local/bin, where sops and age are usually installed.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Bounded like the Windows task (#627): a hung git/ssh/sops never holds the
# unit. When TimeoutStartSec expires systemd kills the whole cgroup, so no
# orphaned child survives, and the next timer tick starts clean. 2026-11-13
# collection: this unit had TimeoutStartUSec=infinity on A6000 and Tokyo.
TimeoutStartSec=150
KillMode=control-group
# Fail fast on a dead link instead of waiting for TCP to give up.
Environment="GIT_SSH_COMMAND=ssh -o ConnectTimeout=10 -o ServerAliveInterval=5 -o ServerAliveCountMax=3"
ExecStart=@PYTHON@ @SECRET_TOOL@ sync
# Values are written to 0600 env files and never to the journal.
StandardOutput=journal
