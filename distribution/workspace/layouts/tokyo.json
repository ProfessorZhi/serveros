{
  "schema": "serveros/device-layout.v1",
  "device": "tokyo",
  "device_ref": "device:tokyo-shared-dev-01",
  "principal": "vince",
  "home": "/data/home/vince",
  "work_root": "/data/home/vince/work",
  "scan_roots": ["/data/home/vince", "/data/scratch/vince"],
  "zones": [
    {"path": "work/src", "kind": "managed", "purpose": "每个仓库一份主 clone"},
    {"path": "work/worktrees", "kind": "managed", "purpose": "worktrees/<仓库>/<条目编号>", "retain_days": 14},
    {"path": "work/scratch", "kind": "managed", "purpose": "临时实验，到期清", "retain_days": 30},
    {"path": "work/artifacts", "kind": "artifact", "purpose": "artifacts/<项目>/<条目编号>/<运行>", "retain_days": 60},
    {"path": "work/records", "kind": "managed", "purpose": "hwz-records 与 fleet-journal 的工作 clone"}
  ],
  "registered": [
    {"path": ".cache", "purpose": "工具缓存（uv、pip、playwright）"},
    {"path": ".npm", "purpose": "npm 缓存"},
    {"path": ".local", "purpose": "本机程序与状态（CloudCLI 程序、serveros 状态）"},
    {"path": ".config", "purpose": "配置"},
    {"path": ".claude", "purpose": "Claude Code 数据"},
    {"path": ".codex", "purpose": "Codex 数据"},
    {"path": ".cloudcli", "purpose": "CloudCLI 数据库"},
    {"path": ".vscode-server", "purpose": "VS Code Remote"},
    {"path": ".ssh", "purpose": "SSH"},
    {"path": "toolchains", "purpose": "按版本分根的工具链"},
    {"path": "runtime-assets", "purpose": "设备插件运行时（device_kit 安装）"},
    {"path": "build", "purpose": "设备插件构建目录（device_kit）"},
    {"path": "serveros-secrets", "purpose": "密钥中心（加密仓）"},
    {"path": "serveros-secrets.git", "purpose": "密钥中心（加密仓）"},
    {"path": "software", "purpose": "手装软件"},
    {"path": "envs", "purpose": "Python 环境"},
    {"path": "node_modules", "purpose": "全局 node 依赖"},
    {"path": "Desktop", "purpose": "桌面"},
    {"path": "Documents", "purpose": "文档"},
    {"path": "downloads", "purpose": "下载"},
    {"path": "MarketOps", "purpose": "MarketOps 运行目录"}
  ],
  "protected": [],
  "legacy": [
    {"from": "workspace/src/*", "as": "repo", "why": "旧布局的主 clone"},
    {"from": "src/*", "as": "repo", "why": "第二套主 clone 目录"},
    {"from": "workspace/worktrees/*/*", "as": "worktree", "why": "旧布局的 worktree"},
    {"from": "workspace/ops", "as": "repo", "why": "hwz-records 的旧 clone"},
    {"from": "workspace/records", "as": "repo", "why": "hwz-records 的旧 clone"},
    {"from": "workspace/scratch/*", "as": "scratch", "why": "旧 scratch"},
    {"from": "workspace/test-envs/*", "to": "work/test-envs/{name}", "why": "测试环境定义"},
    {"from": "fleet-journal", "to": "work/records/fleet-journal", "why": "fleet-journal 的工作 clone"},
    {"from": "artifacts/*", "to": "work/artifacts/{name}", "why": "旧产物目录"},
    {"from": "claude-task.*", "as": "scratch", "why": "agent 任务临时目录"},
    {"from": "kit-update.*", "as": "scratch", "why": "device_kit 更新临时目录"},
    {"from": "tmp-*", "as": "scratch", "why": "一次性临时目录"},
    {"from": "tmp", "as": "scratch", "why": "旧 tmp"},
    {"from": "dk-pr", "as": "scratch", "why": "一次性 PR 目录"},
    {"from": "voice-probe", "as": "scratch", "why": "一次性探针"},
    {"from": "marketops-accept-*", "as": "scratch", "why": "一次性验收目录"},
    {"from": "/data/scratch/vince/*", "as": "scratch", "why": "数据盘上的旧 scratch"},
    {"from": "state", "as": "report", "why": "旧布局的状态快照（7.6 GB），先看内容再定"},
    {"from": "logs", "as": "report", "why": "旧日志目录，10-08 后不再写入"},
    {"from": "backups", "as": "report", "why": "迁移备份（9.7 GB），先看内容再定"},
    {"from": "data", "as": "report", "why": "名字太泛，先看内容再定"},
    {"from": "caches", "as": "report", "why": "旧缓存"},
    {"from": "ccprov", "as": "report", "why": "用途不明"},
    {"from": "w3-research", "as": "report", "why": "调研目录"},
    {"from": "marketops-w1-pool", "as": "report", "why": "MarketOps 运行池"}
  ]
}
