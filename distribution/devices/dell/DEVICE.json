{
  "schema": "serveros/fleet-device-kit.v1",
  "device": "dell",
  "device_ref": "device:llm-lab-dell",
  "principal": "fjd",
  "os": "linux",
  "role": "company GPU compute and model deployment first; background work (production observation, shared-gateway changes, tests) while Windows is short of resources",
  "hub": "tokyo",
  "layers": {
    "core": {
      "source": "plugin/profiles/linux-work.yaml",
      "composition": "serveros-linux-work",
      "name": "hwz-server-os-linux-work",
      "display_name": "HWZ ServerOS (Linux Work)",
      "version": "3.1.0+srv0005.20261014a",
      "skills": [
        "serveros",
        "runtime-management",
        "ability-management",
        "workspace-management",
        "test-management"
      ],
      "claude_code": "hwz-server-os-linux-work@hwz-server-os-linux-work",
      "codex": "hwz-server-os-linux-work@hwz-server-os-linux-work-local",
      "agents": [
        "claude-code",
        "codex"
      ],
      "node_runtime": "serverosd + serverosctl (same payload, promoted as node-runtime)"
    },
    "family": {
      "repo": "ProfessorZhi/ability-management",
      "profile": "dell-gpu-compute",
      "agents": [
        "claude-code",
        "codex"
      ],
      "revision": "pinned at install (--ability-rev)",
      "cloudcli": "also rolled out into the Claude config dir a running CloudCLI uses (read from the process at install)"
    },
    "monitor": {
      "serverosd": {
        "what": "basic: resources, anomalies, runtime status (python daemon)",
        "unit": "serverosd.service",
        "template": {
          "path": "runtime/serverosd.service",
          "digest": "sha256:b026513ac1000122950bfee62be2ba915224225afc6a6800083a63610b949e23"
        }
      },
      "core_lite": {
        "what": "native: C++ collector → status.json (0600) every 30 s, observe only",
        "profile": {
          "path": "native/node-core/core-lite/profiles/dell-fjd.profile.json",
          "digest": "sha256:e528411717947f47782af9aab257fe23d8152432b9fbfa124ff726abafe49c48"
        },
        "units": [
          "serveros-core-lite-publish.service",
          "serveros-core-lite-publish.timer"
        ],
        "templates": [
          {
            "path": "native/node-core/core-lite/deploy/serveros-core-lite-publish.service",
            "digest": "sha256:1f97075d0314a14ebc1a30bb30e963295b6d970b2f3f85313f9991d3972f42bb"
          },
          {
            "path": "native/node-core/core-lite/deploy/serveros-core-lite-publish.timer",
            "digest": "sha256:249ade5c4efe841e0e07725c15a94bbcb3a4657f59dc7730485f0d933482de9f"
          },
          {
            "path": "native/node-core/core-lite/deploy/publish-status.sh",
            "digest": "sha256:d3d63e0a718158639036eb5d6d42aa1b0a0444cc74e133474140fead3260cd62"
          }
        ],
        "status_file": "~/.local/state/serveros/core-lite/status.json"
      },
      "node_connector": {
        "what": "link: reports this device to the hub (tokyo)",
        "template": {
          "path": "fleet_mcp/node/systemd/user/serveros-fleet-node-connector.service.in",
          "digest": "sha256:6d3c7e2d9833ff66e25c3499b5b1091faaeeec2fb9cddafcd63b867d5cf89e99"
        }
      }
    }
  },
  "wiring": {
    "hub_binding": "device:llm-lab-dell|claude-fjd  with  account: fjd",
    "connector_binding": "runtime: claude-fjd"
  }
}
