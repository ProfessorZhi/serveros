{
  "schema": "serveros/fleet-device-kit.v1",
  "device": "work-fj",
  "device_ref": "device:work-fj",
  "principal": "Vince.Huang",
  "os": "windows",
  "role": "company Windows — real-client E2E, browser, office documents",
  "hub": "tokyo",
  "layers": {
    "core": {
      "composition": null,
      "agents": [
        "claude-code",
        "codex"
      ],
      "note": "core skills arrive as standalone skills through the family profile"
    },
    "family": {
      "repo": "ProfessorZhi/ability-management",
      "profile": "work-fj-windows",
      "agents": [
        "claude-code",
        "codex"
      ],
      "revision": "pinned at install (--ability-rev)"
    },
    "monitor": {
      "secrets_sync": {
        "what": "key center: pull the secrets repository, decrypt this device's bundles (SOPS + age) into env files only this account can read, restart named tasks",
        "task": "\\ServerOS\\ServerOS Secrets sync (scheduled task, this user, every 5 minutes)",
        "templates": [
          {
            "path": "distribution/keycenter/windows/register-sync-task.ps1",
            "digest": "sha256:96cb9127162ae0164f4af2f483460d89d09da55145c51d3eca07b0b95989a0ec"
          },
          {
            "path": "distribution/keycenter/windows/sync-secrets.ps1",
            "digest": "sha256:082bff16094b39314664905cb223f53b8254c9b6573ef54a7d83896ac516fb9a"
          },
          {
            "path": "distribution/keycenter/windows/run-hidden-wait.vbs",
            "digest": "sha256:bbac967507420bd1df299fcfd9e7188b884e7546befb68cb8ab9cedefd5cf191"
          }
        ],
        "tool": {
          "path": "distribution/keycenter/serveros_secret.py",
          "digest": "sha256:679faf93820ac6e2a1c85581470b2c9ccf1b25ab699982ecbe0868685776b6d9"
        },
        "log": "%LOCALAPPDATA%\\ServerOS\\state\\secrets-sync.log (names only)"
      },
      "core_lite": {
        "what": "native: C++ Windows collector (Win32) → status.json every minute, observe only",
        "profile": {
          "path": "native/node-core/core-lite/profiles/work-fj.profile.json",
          "digest": "sha256:9b338a8b5b5431f63af17f13e3d5aec9046d862ac3f829e09d98e20edcd90e47"
        },
        "build": "native/node-core/core-lite/windows (MSVC, static)",
        "task": "\\ServerOS\\ServerOS Core-Lite publish (scheduled task, this user)",
        "templates": [
          {
            "path": "native/node-core/core-lite/windows/deploy/publish-status.ps1",
            "digest": "sha256:aae62c27ae33a22e73a6f4b658661052e2e4fa227e2bf194ebe54180f8b62b3a"
          },
          {
            "path": "native/node-core/core-lite/windows/deploy/register-publish-task.ps1",
            "digest": "sha256:bc52a5a9dc85f39eb88397f25ce51071869e1344b91f0d0a58ac60c599b4bddb"
          },
          {
            "path": "native/node-core/core-lite/windows/deploy/run-hidden-wait.vbs",
            "digest": "sha256:c73f9ba68fffdb2672f0949d7c96d5e761f718679ae114ddbd70faa9d1b0fef8"
          },
          {
            "path": "native/node-core/core-lite/windows/deploy/probe-network.ps1",
            "digest": "sha256:8c5fcda4f6f7390e781acdbdcf6d5433377237607207e27b2b2a16f0cc2f3994"
          }
        ],
        "status_file": "%LOCALAPPDATA%\\ServerOS\\state\\core-lite\\status.json"
      },
      "node_connector": {
        "what": "link: reports this device to the hub (tokyo)",
        "template": {
          "path": "fleet_mcp/node/install.ps1",
          "digest": "sha256:06f7ece1ae54e84b715c22c41238d9882e07f8106ff9249f3b6708b97545984f"
        },
        "launcher": {
          "path": "fleet_mcp/node/run-hidden-wait.vbs",
          "digest": "sha256:ed581861f0215afae648d96bc61f792c7909f085ab3e2983a1883e9510bf961c"
        }
      }
    }
  },
  "wiring": {
    "hub_binding": "device:work-fj|claude-vince.huang  with  account: Vince.Huang",
    "connector_binding": "runtime: claude-vince.huang  and  core_snapshot_path: <Resolve-Path of %LOCALAPPDATA%\\ServerOS\\state\\core-lite\\status.json>"
  }
}
